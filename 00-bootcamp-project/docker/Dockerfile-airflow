FROM --platform=$BUILDPLATFORM apache/airflow:3.3.0-python3.10

USER root

RUN apt-get update \
    && apt-get install -y iputils-ping \
    && apt-get install -y --no-install-recommends \
         openjdk-17-jre-headless \
    && apt-get autoremove -yqq --purge \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Remove any stale Spark/PySpark files before installing the course-pinned version.
# The Spark provider also installs pyspark-client, so keep both packages on the
# same Spark version to avoid a mixed pyspark package tree.
RUN rm -rf \
      /home/airflow/.local/lib/python3.10/site-packages/pyspark \
      /home/airflow/.local/lib/python3.10/site-packages/pyspark-*.dist-info \
      /home/airflow/.local/lib/python3.10/site-packages/pyspark_client-*.dist-info \
      /home/airflow/.local/bin/find_spark_home \
      /home/airflow/.local/bin/pyspark \
      /home/airflow/.local/bin/spark-class \
      /home/airflow/.local/bin/spark-shell \
      /home/airflow/.local/bin/spark-sql \
      /home/airflow/.local/bin/spark-submit \
    || true

USER airflow

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=/home/airflow/.local/bin:${PATH}

# Day 4 only needs Airflow + Spark. Do not install the Week 5 dbt/cosmos stack
# here: its storage pins conflict with the Airflow 3.3.0 base image.
RUN python -m pip install --no-cache-dir \
      pyspark==4.1.0 \
      pyspark-client==4.1.0 \
      apache-airflow-providers-apache-spark==6.2.0 \
    && python -m pip check

# Fail the image build immediately if PySpark or the Spark provider is broken.
RUN python -c "import pyspark; assert pyspark.__version__ == '4.1.0'; print('PySpark', pyspark.__version__, 'OK')" \
    && python -c "from pyspark.core.status import StatusTracker, SparkJobInfo, SparkStageInfo; print('PySpark status API OK')" \
    && python -c "from airflow.providers.apache.spark.operators.spark_submit import SparkSubmitOperator; print('Spark provider OK')"

COPY --chown=airflow:0 ./conf/spark-defaults.conf /home/airflow/.local/lib/python3.10/site-packages/pyspark/conf/spark-defaults.conf
COPY --chown=airflow:0 ./conf/metrics.properties /home/airflow/.local/lib/python3.10/site-packages/pyspark/conf/metrics.properties
COPY --chown=airflow:0 ./jars/gcs-connector-hadoop3-latest.jar /home/airflow/.local/lib/python3.10/site-packages/pyspark/jars/gcs-connector-hadoop3-latest.jar

ENV SPARK_CONF_DIR=/home/airflow/.local/lib/python3.10/site-packages/pyspark/conf
